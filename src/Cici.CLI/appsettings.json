{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "Cici": {
    "DefaultRepeatCount": 10,
    "DefaultTimeout": 30,
    "MaxParallelTests": 4,
    "Reports": {
      "Console": {
        "UseColors": true,
        "ShowProgress": true
      },
      "Json": {
        "Indent": true,
        "IncludeExecutionDetails": true
      }
    }
  }
}
