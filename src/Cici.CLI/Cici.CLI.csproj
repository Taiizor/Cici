<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>cici</ToolCommandName>
        <PackageId>Cici.CLI</PackageId>
        <Version>1.0.0</Version>
        <Authors>Cici Team</Authors>
        <Description>Flaky Test Detector for .NET - CLI Tool</Description>
        <PackageTags>testing;flaky;test;automation;ci;quality;cli</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Taiizor/Cici</RepositoryUrl>
        <AssemblyName>cici-cli</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cici\Cici.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.48.0" />
    </ItemGroup>

</Project>
